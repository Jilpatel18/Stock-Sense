# Neon PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-host.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="your_production_super_secret_jwt_key_at_least_32_chars"

# Email Configuration
EMAIL_PROVIDER="console" # 'console' | 'smtp'
EMAIL_FROM="no-reply@stocksense.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASSWORD="smtp_password"
